# Copier vers .env.local. Aucune variable n'est nécessaire en développement.
# Les variables NEXT_PUBLIC_* sont lues au moment du build.

# URL publique du site, sans barre finale. Obligatoire en production (le build Vercel ou Netlify échoue sans elle).
NEXT_PUBLIC_SITE_URL=

# Affichage des prix (V2). Par défaut : false.
NEXT_PUBLIC_COMMERCE_ENABLED=false

# Étiquettes {{TODO_CLIENT}} et briefs photo. Sans réglage : visibles en développement, masqués en production.
# NEXT_PUBLIC_SHOW_TODOS=true

# Envoi des formulaires par Resend. Sans ces variables, les formulaires répondent par une erreur en production.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
# Audience Resend de la lettre d'information (facultatif).
RESEND_AUDIENCE_ID=

# Contenu depuis Sanity au lieu des fichiers JSON (facultatif, non testé).
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Mesure d'audience sans cookie (facultatif).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
